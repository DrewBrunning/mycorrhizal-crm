<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #1133: the FCM entry point is registered only for the `obtainium` and
  `play` distribution flavors (this manifest is included by both source sets).
  The `foss` (F-Droid) variant carries no Firebase SDK, so it must not declare
  a service whose superclass does not exist on its classpath.

  With no google-services.json the Firebase runtime never initializes and the
  service is simply never invoked, leaving the WorkManager polling workers as
  the sole push path.

  allowBackup="false" repeats the value the merged app manifest already sets
  (app/src/main/AndroidManifest.xml). It is spelled out here because mobsfscan
  audits each source manifest standalone and cannot see the merge, so an
  overlay without the explicit flag raises
  android_manifest_missing_explicit_allow_backup (code-scanning alert #277).
  Mirrors :macrobenchmark's manifest.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application android:allowBackup="false">
        <service
            android:name="com.mycorrhizal.crm.push.MyFirebaseMessagingService"
            android:exported="false"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
