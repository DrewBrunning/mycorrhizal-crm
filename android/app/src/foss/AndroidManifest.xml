<?xml version="1.0" encoding="utf-8"?>
<!--
  Issue #1133: the F-Droid (foss) flavor carries no Firebase SDK, so the FCM
  service declared in the main manifest must be removed — a declared service
  whose superclass is not on the variant's classpath must not survive the
  merge. Reminder push on this flavor comes solely from the WorkManager
  polling workers.

  The FCM service (and its Kotlin implementation) is included by the
  `obtainium` and `play` flavors; see app/build.gradle.kts's sourceSets and
  docs/adrs/0022-distribution-variants.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- MissingClass: the class is deliberately absent from this flavor;
             the node exists only to remove the main manifest's declaration. -->
        <service
            android:name="com.mycorrhizal.crm.push.MyFirebaseMessagingService"
            tools:node="remove"
            tools:ignore="MissingClass,Instantiatable" />
    </application>

</manifest>
