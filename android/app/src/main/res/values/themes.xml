<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Mycorrhizal" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Brand-green status bar with light (white) status icons, so the
             whole top reads as one mycelium band. Screens that collapse their
             app bar (contact detail) override this at runtime via the scroll
             state (bone at the top, green once collapsed). The bone-colored
             navigation bar gets dark (light-appearance) icons/buttons via
             android:windowLightNavigationBar, but that attribute requires API
             27+ (min is 26), so it's added on top of this base theme in
             values-v27/themes.xml instead of here. -->
        <item name="android:statusBarColor">#3E543E</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FAF5EA</item>
    </style>

    <!-- Identity theme for API < 27; values-v27/themes.xml overrides this
         with the windowLightNavigationBar addition on API 27+. -->
    <style name="Theme.Mycorrhizal" parent="Base.Theme.Mycorrhizal" />

    <!-- T106: splash theme, shown by the OS before installSplashScreen()'s
         postSplashScreenTheme swaps in Theme.Mycorrhizal. Split the same way
         as the pair above so values-night/themes.xml only has to override the
         background. No dedicated splash icon asset exists; the adaptive
         launcher-icon foreground (already used by mipmap-anydpi-v26/ic_launcher.xml)
         is reused as-is, per platform convention for apps without one. -->
    <style name="Base.Theme.Mycorrhizal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mycorrhizal</item>
    </style>

    <style name="Theme.Mycorrhizal.Splash" parent="Base.Theme.Mycorrhizal.Splash">
        <item name="windowSplashScreenBackground">#FAF5EA</item> <!-- bone -->
    </style>
</resources>
