<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- android:windowLightNavigationBar requires API 27+; min is 26, so this
         API-27+-only override restores the bone-colored navigation bar with
         dark (light-appearance) icons/buttons. The API-26 base theme in
         values/themes.xml uses the brand-green bar with light icons instead
         (issue #1920). -->
    <style name="Theme.Mycorrhizal" parent="Base.Theme.Mycorrhizal">
        <item name="android:navigationBarColor">#FAF5EA</item> <!-- bone -->
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
