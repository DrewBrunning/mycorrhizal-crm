<?xml version="1.0" encoding="utf-8"?>
<!--
    TLS trust model (ticket §9.5).

    Production: system CAs only, cleartext forbidden. Self-hosted servers with
    self-signed certs are handled via the KeyChain import flow (installCustomCertificate),
    never by disabling TLS verification.

    This is the config a RELEASE build actually uses. Debug builds don't use
    this file at all — the debug source set fully replaces it with
    app/src/debug/res/xml/network_security_config.xml, which is where the
    debug-only <debug-overrides> trusting user-installed CAs lives. Do not add
    a <debug-overrides> block here: lint flags it as a duplicate against the
    debug variant's own block ("Expecting at most 1 <debug-overrides>"), since
    the debug build's resource model merges both files.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
