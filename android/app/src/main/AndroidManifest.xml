<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M1 item 12 (§7.6): the mobile link-action resolver queries
         ContactsContract.Data for the MIMETYPEs that prove an app is installed,
         which requires READ_CONTACTS. Requested inline (not at startup) when a
         known-protocol link is rendered; denied permission degrades the row to
         plain link + copy (§8.3). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Phase 4 tracking (§6.1/6.2): call-log + SMS capture, opt-in at runtime. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 4 quick-capture overlay (§6.5). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- The tracking permissions imply telephony/SMS hardware; mark them as
         not required so non-phone devices (tablets, ChromeOS) can still install. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.telephony.messaging" android:required="false" />

    <!-- Backups are disabled (this app holds contact data); the Android-12+
         dataExtractionRules file makes that explicit for cloud/device
         transfer, and allowBackup covers pre-Android-12. -->
    <application
        android:name=".MycorrhizalApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mycorrhizal"
        tools:node="merge">
        <!-- The app provides WorkManager's Configuration via Configuration.Provider
             (Hilt worker factory), so remove the library's default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 4 quick-capture overlay foreground service (§6.7). -->
        <service
            android:name="com.mycorrhizal.crm.feature.tracking.CallDetectionService"
            android:foregroundServiceType="phoneCall"
            android:exported="false" />

        <!-- Phase 4 tracking receivers (§6.3). -->
        <receiver
            android:name="com.mycorrhizal.crm.feature.tracking.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mycorrhizal.crm.feature.tracking.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="0">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.mycorrhizal.crm.feature.tracking.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
