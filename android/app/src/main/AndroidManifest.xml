<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M1 item 12 (§7.6): the mobile link-action resolver queries
         ContactsContract.Data for the MIMETYPEs that prove an app is installed,
         which requires READ_CONTACTS. Requested inline (not at startup) when a
         known-protocol link is rendered; denied permission degrades the row to
         plain link + copy (§8.3). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Backups are disabled (this app holds contact data); the Android-12+
         dataExtractionRules file makes that explicit for cloud/device
         transfer, and allowBackup covers pre-Android-12. -->
    <application
        android:name=".MycorrhizalApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mycorrhizal">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
