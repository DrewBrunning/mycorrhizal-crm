<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Issue #263: the dashboard scenario ([DashboardRenderBenchmark])
         registers the shared seed account against the docker-compose.test.yml
         backend before driving the login UI, exactly as the instrumented E2E
         suite does. That call is plain cleartext HTTP to the emulator's
         host-loopback alias (http://10.0.2.2:7300) or an adb-reversed
         127.0.0.1. Cleartext is scoped to those loopback aliases only via
         @xml/network_security_config — not a blanket usesCleartextTraffic, and
         never any destination but the test backend. allowBackup is false (no
         app data to back up; mirrors the app manifest). The app under test
         keeps its own locked-down network-security config. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
