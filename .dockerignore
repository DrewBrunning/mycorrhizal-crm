# Root build context
# Keep the context small and avoid leaking local data/secrets.

.git
.github
.gitignore
*.md

# Node
node_modules
frontend/node_modules
frontend/build
frontend/coverage

# Go / backend local artifacts
backend/mycorrhizal
backend/tmp
backend/vendor
backend/*.db
backend/*.sqlite*
backend/**/*_test.go

# Local runtime data (do not bake into the image). The production Dockerfile
# creates its own data dirs inside the container and never copies these in.
data
photos

# Environment files / secrets
**/.env
**/.env.*
backend/my_environment.env

# Editor / OS cruft
.DS_Store
.idea
.vscode
