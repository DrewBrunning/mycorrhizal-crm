# Backend URL (API Server)
# Leave EMPTY for local dev and Docker: the browser then calls the API on
# relative paths. `yarn start` proxies /api, /health and /.well-known to the
# backend (http://localhost:8080, or VITE_DEV_PROXY_TARGET), which keeps the
# app and API same-origin so images (Cross-Origin-Resource-Policy: same-origin)
# load. Setting this to a different origin breaks image loading in dev.
VITE_API_URL=

# Dev-server proxy target (dev only; not used by builds). Default: http://localhost:8080
# VITE_DEV_PROXY_TARGET=http://localhost:8080

# Request Timeout (in milliseconds)
# Default: 30000 (30 seconds)
VITE_REQUEST_TIMEOUT=30000
