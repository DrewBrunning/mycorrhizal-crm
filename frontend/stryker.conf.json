{
  "$schema": "https://json.schemastore.org/stryker.json",
  "mutate": [
    "src/api/*.ts",
    "src/hooks/use*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/api/contractConformance.ts",
    "!src/generated/**"
  ],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "html", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "allowConsoleColors": true,
  "timeoutMS": 60000,
  "dryRunTimeoutMinutes": 30,
  "ignoreStatic": true,
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "thresholds": {
    "high": 92,
    "low": 87,
    "break": 74
  }
}
