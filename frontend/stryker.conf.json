{
  "$schema": "https://json.schemastore.org/stryker.json",
  "mutate": [
    "src/api/contacts.ts",
    "src/api/relationshipEdges.ts",
    "src/api/lifeEvents.ts",
    "src/hooks/useContacts.ts",
    "src/hooks/useRelationshipEdges.ts",
    "src/hooks/useLifeEvents.ts"
  ],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "html", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "allowConsoleColors": true,
  "timeoutMs": 60000,
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "thresholds": {
    "high": 92,
    "low": 87,
    "break": 85
  }
}
