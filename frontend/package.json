    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@types/d3-force": "^3.0.10",
    "d3-force": "^3.0.0",
    "i18next": "^26.4.5",
    "i18next-browser-languagedetector": "^8.2.0",
    "maplibre-gl": "^6.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-force-graph-2d": "^1.29.2",
    "react-i18next": "^17.0.16",
    "react-router": "^8.4.0",
    "web-vitals": "^6.2.3",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "budget:update": "node scripts/check-bundle-budget.mjs --update",
    "lint": "eslint . --max-warnings 46",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:routes": "node scripts/check-e2e-routes.mjs",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "coverage:ratchet:update": "node scripts/check-coverage-ratchet.mjs --update",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:sw": "playwright test -c playwright.sw.config.ts",
    "sw:fixtures": "node e2e/sw-upgrade/fixtures.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "acorn": "^8.19.0",
    "browserslist-to-esbuild": "^2.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "jsdom": "^30",
    "knip": "^6.43.0",
    "license-checker-rseidelsohn": "4.4.2",
    "msw": "^3.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "resolutions": {
    "vite": "^8.3.4",
    "nanoid": "^3.3.18",
    "qs": "^6.16.0",
    "browserslist": "4.28.7"
  }
