{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2",
    "yarn": ">=1.22.0 <2.0.0"
  },
  "browserslist": [
    "Chrome >= 111",
