# Mycorrhizal CRM - Docker Environment Configuration
# Copy this file to .env and update the values.
#
# NOTE: This file uses Docker env_file format (no 'export' prefix).
# For local development, use backend/.env.example instead.

# =============================================================================
# REQUIRED - You must set or consider these values
# =============================================================================

# Security - JWT secret key (minimum 32 characters)
JWT_SECRET_KEY=your-very-long-very-secret-jwt-key-change-this-in-production

# Frontend URL for CORS headers. Must be the exact origin you browse to,
# including scheme and port — it is also what the OIDC redirect URI is derived
# from. The default below matches the compose port mapping
# (FRONTEND_PORT:-7300); change it to your real origin when you deploy
# (e.g. https://crm.example.com).
#
# "*" allows any origin and is DEV-ONLY. The all-in-one Docker image runs with
# GIN_MODE=release, and the server refuses to start with FRONTEND_URL=* in that
# mode rather than silently allowing every origin to send credentialed requests.
FRONTEND_URL=http://localhost:7300

# Email notifications can be delivered via Resend, SMTP, or both.
# If both are set, every email is sent through both channels. Leave a section empty to disable that or both channels.

# Resend (https://resend.com/)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                 # default 587 (STARTTLS); use 465 with SMTP_USE_TLS=true
# SMTP_USERNAME=                # optional; leave empty for unauthenticated relay
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_USE_TLS=false            # true = implicit TLS (port 465); false = plaintext/STARTTLS

# Enable the CardDav server for contact sync (default is false)
CARDDAV_ENABLED='true'

# =============================================================================
# NOTIFICATION CHANNELS
# =============================================================================
#
# Reminders can be delivered by email (above), ntfy, Gotify, and browser push.
# Only email is configured here — the rest are per-user and set in the app under
# Settings → Notifications, because each user has their own ntfy topic, Gotify
# token, and devices:
#
#   ntfy         server URL + topic
#   Gotify       server URL + application token (stored encrypted at rest,
#                using a key derived from JWT_SECRET_KEY)
#   Browser push nothing to configure — the VAPID keypair is generated once on
#                first use and stored in the database. Requires HTTPS (or
#                localhost), since browsers refuse to register a service worker
#                on a plain-HTTP origin.
#
# The one server-side knob for these is WEBHOOK_BLOCK_PRIVATE_URLS below, which
# governs whether the server may post to private/loopback addresses. Self-hosted
# ntfy/Gotify almost always live on a private address, so it defaults to false.
#
# Changing JWT_SECRET_KEY invalidates every stored Gotify token (and calendar
# password, and Immich API key) — they must be re-entered.

# =============================================================================
# DATA STORAGE PATHS
# =============================================================================

# Host paths for persistent data (relative or absolute), use this to declare the volumes on your server
DATA_PATH=./data
PHOTOS_PATH=./photos

# =============================================================================
# DOCKER IMAGE CONFIGURATION
# =============================================================================

# Image tag to pull (e.g., main, v1.0.0, sha-abc1234)
IMAGE_TAG=latest

# =============================================================================
# SINGLE SIGN-ON (OIDC) - Optional
# =============================================================================

# Set all three to enable SSO. The redirect URI is derived from FRONTEND_URL automatically.
# Register https://<your-domain>/api/v1/auth/oidc/callback as the redirect URI in your provider.
OIDC_PROVIDER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Automatically create an account on first SSO login (default: false)
# When false, the user must already have an account (matched by verified email or registered manually)
OIDC_AUTO_PROVISION=false

# Trust email claims from the OIDC provider without requiring email_verified=true (default: false)
# Enable this for self-hosted providers (e.g. Authentik) where you control user accounts.
# WARNING: Do not enable if using a public/untrusted OIDC provider — unverified email claims could allow account takeover of existing accounts.
OIDC_TRUST_EMAIL=false

# Comma-separated list of OAuth2/OIDC scopes to request (default: openid,email,profile)
# Only change this if your provider needs an additional scope (e.g. a custom claim scope).
OIDC_SCOPES=openid,email,profile

# =============================================================================
# HOST PORT
# =============================================================================

# Host port the app is exposed on (default: 7300)
FRONTEND_PORT=7300

# =============================================================================
# OPTIONAL - These have sensible defaults
# =============================================================================

# JWT token expiry in hours
JWT_EXPIRY_HOURS=96

# Cookie Configuration
COOKIE_SECURE='false'

# Leave empty (recommended). Empty makes auth_token a host-only cookie, valid
# for exactly the host you opened the app on — localhost, a LAN IP, or a domain
# — and sent nowhere else. A value that does not match that host makes the
# browser silently discard the cookie, which looks like an endless redirect
# back to the login page. An IP address never works here.
#
# Only set this when the frontend and API are on different subdomains
# (app.example.com and api.example.com), where it would be '.example.com'.
# Note that widening it this way also exposes the auth cookie to every other
# subdomain of that domain, so scope it as narrowly as the setup allows.
COOKIE_DOMAIN=

# Daily reminder notification time (HH:MM format, 24-hour), default 06:00.
# Applies to every enabled channel, not just email.
REMINDER_TIME=06:00
# Timezone for reminder scheduling. Must be a valid IANA timezone name.
REMINDER_TIMEZONE=UTC

# How long soft-deleted contacts, notes and activities remain recoverable before
# the purge job removes them permanently (default: 30 days). This is a real
# data-retention decision, not a tuning knob — lowering it shortens the window in
# which a deletion can still be undone. Set to 0 to disable the purge job and
# keep soft-deleted rows forever.
DELETED_RETENTION_DAYS=30

# Trusted reverse-proxy addresses, comma-separated. Leave empty unless the app
# sits behind a proxy you control; it determines which X-Forwarded-For values the
# server believes when deriving a client IP for rate limiting.
TRUSTED_PROXIES=

# API rate limiting: one token every INTERVAL_MS, up to BURST tokens, per client
# IP. The defaults suit a personal instance. Raise BURST if a busy page load
# (a contact detail view issues roughly 18 requests) starts returning 429s.
API_RATE_LIMIT_INTERVAL_MS=600
API_RATE_LIMIT_BURST=1000

# HTTP Server Timeouts (in seconds)
HTTP_READ_TIMEOUT=15
HTTP_WRITE_TIMEOUT=15
HTTP_IDLE_TIMEOUT=60

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# Disable new user registration (default: false)
DISABLE_REGISTRATION=false

# Block webhook deliveries AND notification-channel posts (ntfy/Gotify, N9) to
# private/internal IP ranges, relevant for cloud or multi-tenant setups to
# prevent SSRF attacks via outgoing webhooks/notifications. Self-hosted ntfy/
# Gotify instances are usually on private addresses — set this to false (the
# default) to reach them.
WEBHOOK_BLOCK_PRIVATE_URLS=false

# Calendar sync (CalDAV/ICS activity import), default every 6 hours
# Stored calendar passwords are encrypted with a key derived from JWT_SECRET_KEY;
# changing JWT_SECRET_KEY means calendar passwords must be re-entered.
CALDAV_SYNC_INTERVAL_HOURS=6
# Block calendar URLs resolving to private/loopback addresses, relevant for cloud or multi-tenant setups (prevent SSRF)
CALDAV_BLOCK_PRIVATE_URLS=false

# Immich integration. The Immich base URL is entered per-user in the app and is
# typically a PRIVATE self-hosted address (http://immich:2283 or a LAN host),
# which is why IMMICH_BLOCK_PRIVATE_URLS defaults to false — blocking private
# addresses would make the integration useless for most self-hosters. Set it to
# true for cloud/multi-tenant deployments. The per-user Immich API key is stored
# encrypted at rest, like Gotify tokens and calendar passwords.
IMMICH_SYNC_INTERVAL_HOURS=6
IMMICH_BLOCK_PRIVATE_URLS=false
